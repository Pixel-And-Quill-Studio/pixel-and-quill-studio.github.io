---
/** Page shell: head (SEO, language alternates, detection script), header, footer. */
import Newsletter from "../components/Newsletter.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { SITE, LANGS, PUBLISHED, DEFAULT, ORIGIN, BASE, FB_DOMAIN_VERIFICATION, t, url, langScript, SWITCH_SCRIPT, CONSENT_BOOT_SCRIPT, COOKIE_SCRIPT, ogImage, jsonLd } from "../lib/site";

interface Props {
  pageKey: string; lang: string; title: string; desc: string;
  nav?: string; home?: boolean; noindex?: boolean; detect?: boolean;
}
const { pageKey, lang, title, desc, nav, home = false, noindex = false, detect = true } = Astro.props;
const canonical = ORIGIN + url(pageKey, lang);
// Facebook domain verification (public token), on the home pages only.
const fbv = !noindex && pageKey === "home";
const menu = [["home", t(lang, "home")], ["games", t(lang, "games")], ["contact", t(lang, "contact")]];
const s = SITE;
const ogAlt = t(lang, "og_image_alt");
const ld = noindex ? null : { "@context": "https://schema.org", "@graph": jsonLd(pageKey, lang) };
---
<!doctype html>
<html lang={lang}><head><meta charset="utf-8"><meta name="google-adsense-account" content="ca-pub-5227293216340878"><meta name="viewport" content="width=device-width,initial-scale=1">
{detect && <script is:inline set:html={langScript(pageKey, lang)}></script>}<script is:inline set:html={CONSENT_BOOT_SCRIPT}></script><title>{title}</title><meta name="description" content={desc}>{noindex && <meta name="robots" content="noindex">}
<link rel="stylesheet" href="/assets/style.css">
<link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/assets/brand/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/assets/brand/favicon-48.png" sizes="48x48" type="image/png">
<link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png">
<link rel="canonical" href={canonical}>
{PUBLISHED.map((c) => <link rel="alternate" hreflang={c} href={ORIGIN + url(pageKey, c)}>)}<link rel="alternate" hreflang="x-default" href={ORIGIN + url(pageKey, DEFAULT)}>
<meta name="theme-color" content="#0b0b0d">
<meta property="og:type" content="website"><meta property="og:site_name" content="Pixel &amp; Quill Studio">
<meta property="og:title" content={title}><meta property="og:description" content={desc}>
<meta property="og:url" content={canonical}><meta property="og:locale" content={LANGS[lang].locale}>
<meta property="og:image" content={`${BASE}${ogImage(lang)}`}><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogAlt}>{PUBLISHED.filter((c) => c !== lang).map((c) => <meta property="og:locale:alternate" content={LANGS[c].locale}>)}
<meta name="twitter:title" content={title}><meta name="twitter:description" content={desc}>
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content={`${BASE}${ogImage(lang)}`}><meta name="twitter:image:alt" content={ogAlt}>{fbv && <meta name="facebook-domain-verification" content={FB_DOMAIN_VERIFICATION} />}
{ld && <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)}></script>}</head>
<body><a class="skip" href="#main">{t(lang, "skip")}</a><div class="wrap"><header class="top"><a class={home ? "brand home" : "brand"} href={url("home", lang)} aria-label="Pixel &amp; Quill Studio"><img class="brand-icon" src="/assets/brand/favicon.svg" alt="" width="44" height="44"><img class="brand-word" src="/assets/brand/logo-wordmark-inline.svg" alt="Pixel &amp; Quill Studio" height="24"></a>
<nav class="menu" aria-label="Menu">{menu.map(([k, lbl]) => <a class={k === nav ? "on" : undefined} href={url(k, lang)}>{lbl}</a>)}</nav>
<details class="lang-drop"><summary aria-label={`${t(lang, "lang_nav")}: ${LANGS[lang].name}`} aria-expanded="false"><Fragment set:html={'<svg class="globe" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>'} /><span>{LANGS[lang].label}</span><Fragment set:html={'<svg class="chev" aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6"/></svg>'} /></summary><nav aria-label={t(lang, "lang_nav")}>{PUBLISHED.map((c) => <a class={c === lang ? "on" : ""} aria-current={c === lang ? "true" : undefined} hreflang={c} lang={c} data-lang={c.toLowerCase()} href={url(pageKey, c)}>{LANGS[c].name}</a>)}</nav></details></header>
<main id="main"><slot /></main><footer>{!home && pageKey !== "game:sentence" && pageKey !== "privacy" && <Newsletter lang={lang} compact />}<p>© {s.year} {s.name} — {s.owner}, EI — SIREN {s.siren} — {s.address}</p><p class="foot-links"><a class="foot-mail" href={`mailto:${s.email}`}>{s.email}</a><a href={url("legal", lang)}>{t(lang, "legal")}</a><a href={url("privacy", lang)}>{t(lang, "privacy")}</a><a href="#pq-cookies" data-cookie-settings>{t(lang, "cookie_settings")}</a><a href={url("terms", lang)}>{t(lang, "terms")}</a><a href={url("press", lang)}>{t(lang, "press")}</a></p></footer></div><CookieBanner lang={lang} /><script is:inline set:html={SWITCH_SCRIPT}></script><script is:inline set:html={COOKIE_SCRIPT}></script></body></html>
